GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Sign-in. Only these email domains (comma separated) can sign in with Google.
AUTH_ALLOWED_DOMAINS=t1a.com
# Development login: pick a demo persona instead of Google. 1 = on, 0 = off.
# Empty = on only while the Google credentials above are empty. Never enable on a shared server.
AUTH_DEV_LOGIN=
# Session lifetime in hours.
SESSION_TTL_HOURS=12
